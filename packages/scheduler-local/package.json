{
  "name": "@zhchxiao123/dsh-scheduler-local",
  "description": "SQLite local provider for host-level durable scheduling",
  "version": "0.4.0-dev.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhchxiao123/dsh-devflow-plugins.git",
    "directory": "packages/scheduler-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@zhchxiao123/dsh-scheduler": "workspace:^",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@zhchxiao123/dsh-scheduler": "workspace:^",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2"
  },
  "scripts": {
    "prepublishOnly": "node -e \"for (const f of require('./package.json').files.filter(f=>!f.includes('*'))) if (!require('node:fs').existsSync(f)) { console.error('prepublishOnly: '+f+' is missing; run pnpm run build at the repo root'); process.exit(1) }\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "cron-parser": "5.4.0",
    "@zhchxiao123/dsh-automation-project": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
