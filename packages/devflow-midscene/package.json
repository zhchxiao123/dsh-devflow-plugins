{
  "name": "@zhchxiao123/dsh-devflow-midscene",
  "description": "Midscene Web acceptance runbook and isolated CLI runner",
  "version": "0.4.0-dev.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhchxiao123/dsh-devflow-plugins.git",
    "directory": "packages/devflow-midscene"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./runner": {
      "types": "./lib/types/runner.d.ts",
      "default": "./lib/runner.js"
    }
  },
  "files": [
    "assets",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "lib/**/*.js"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@zhchxiao123/dsh-devflow": "0.4.0-dev.7",
    "@zhchxiao123/dsh-devflow-gates": "0.4.0-dev.7",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@zhchxiao123/dsh-devflow-web": "0.4.0-dev.7",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@midscene/web": "1.12.6",
    "playwright": "1.63.0",
    "@playwright/test": "1.63.0",
    "@midscene/shared": "1.12.6",
    "@midscene/core": "1.12.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@zhchxiao123/dsh-devflow": "workspace:*",
    "@zhchxiao123/dsh-devflow-gates": "workspace:*",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-alpha.2",
    "@zhchxiao123/dsh-devflow-web": "workspace:*",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-alpha.2"
  },
  "scripts": {
    "prepublishOnly": "node -e \"for (const f of require('./package.json').files.filter(f=>!f.includes('*'))) if (!require('node:fs').existsSync(f)) { console.error('prepublishOnly: '+f+' is missing; run pnpm run build at the repo root'); process.exit(1) }\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-midscene": "lib/cli.js"
  }
}
