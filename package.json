{
  "name": "@zhchxiao123/dsh-devflow-plugins",
  "private": true,
  "type": "module",
  "description": "devflow for DeepSeek Harness: a standalone plugin line over the ctx.devflow capability seam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhchxiao123/dsh-devflow-plugins.git"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "init": "bash scripts/init.sh",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm run clean && tsc -b tsconfig.json && tsdown && tsdown --config tsdown.client.ts",
    "clean": "tsx scripts/clean.ts",
    "lint": "oxlint .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:types": "tsc -b tsconfig.json",
    "build:client": "tsdown --config tsdown.client.ts",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:tarballs": "tsx scripts/preflight.ts --no-registry",
    "release": "pnpm run verify && pnpm run build && pnpm run preflight && pnpm publish -r --access public",
    "set-version": "tsx scripts/set-version.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.24.0"
}
